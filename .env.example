# Forma local MCP (server-side only)
FORMA_MODE=local
FORMA_MCP_URL=http://127.0.0.1:8000/mcp
FORMA_CLIENT_PATH=C:\Users\PC\forma-oss\.agents\skills\forma-hardware\scripts\forma.py
